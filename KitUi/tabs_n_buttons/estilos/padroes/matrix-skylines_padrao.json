    "--k-field-inset": "none",
    "--k-gap": "3px",
    "--k-pad": "4px",
    "--k-pad-x": "4px",
    "--k-pad-y": "1px",
    "--k-control-h": "20px",
    "--k-icon-size": "12px",
    "--k-icon-size-sm": "10px",
    "--k-icon-size-lg": "14px",
    "--k-icon-size-xl": "16px",
    "--k-choice-size": "12px",
    "--k-switch-w": "26px",
    "--k-switch-h": "14px",
    "--k-switch-knob": "10px",
    "--k-card-pad": "4px",
    "--k-section-pad": "6px"
