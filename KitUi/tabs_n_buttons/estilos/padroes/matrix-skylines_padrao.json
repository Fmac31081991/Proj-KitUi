    "--k-fs-h2": "14px",
    "--k-fs-h3": "11.5px",
    "--k-lh": "1.2",
    "--k-weight": "400",
    "--k-weight-strong": "600",
    "--k-weight-label": "500",
    "--k-track": "0.01em",
    "--k-radius-xs": "0px",
    "--k-radius-sm": "0px",
    "--k-radius-md": "0px",
    "--k-radius-lg": "0px",
    "--k-radius-pill": "0px",
    "--k-radius-round": "0px",
    "--k-bw": "1px",
    "--k-shadow-sm": "none",
    "--k-shadow-md": "none",
    "--k-shadow-inset": "none",
    "--k-btn-shadow": "none",
    "--k-btn-shadow-hover": "none",
