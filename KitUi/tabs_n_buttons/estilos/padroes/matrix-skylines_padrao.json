{
  "id": "matrix-skylines",
  "name": "Matrix Skylines",
  "family": "Padrão",
  "note": "Terminal matrix monoespaçado, verde neon, ícones e controles minúsculos, espaços extremamente compactos.",
  "swatch": [
    "#00FF66",
    "#0B120D",
    "#071B10"
  ],
  "font": "JetBrains Mono",
  "radius": "sharp",
  "density": "compact",
  "tokens": {
    "--k-bg": "#060B08",
    "--k-surface": "#0B120D",
    "--k-surface-2": "#111A14",
    "--k-text": "#B7FFD0",
    "--k-muted": "#5FA777",
    "--k-border": "#1E3A2A",
    "--k-primary": "#00FF66",
    "--k-on-primary": "#041108",
    "--k-accent": "#38F8C4",
    "--k-on-accent": "#041108",
    "--k-danger": "#FF4D6A",
    "--k-on-danger": "#140003",
    "--k-success": "#00FF66",
    "--k-on-success": "#041108",
    "--k-focus": "#38F8C4",
    "--k-stage-bg": "#040805",
    "--k-texture": "linear-gradient(rgba(0,255,102,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,102,.045) 1px, transparent 1px)",
    "--k-texture-size": "24px 24px",
    "--k-font": "\"JetBrains Mono\", ui-monospace, \"Cascadia Code\", Consolas, monospace",
