{
  "id": "editorial",
  "name": "Design Editorial / Tipográfico",
  "family": "Padrão",
  "note": "Tipografia protagonista, colunas assimétricas e hierarchy forte.",
  "swatch": [
    "#111111",
    "#F6F2E9",
    "#E63946"
  ],
  "font": "Playfair Display",
  "radius": "sharp",
  "density": "comfortable",
  "tokens": {
    "--k-bg": "#F6F2E9",
    "--k-surface": "#FFFDF7",
    "--k-surface-2": "#EAE4D6",
    "--k-text": "#14110E",
    "--k-muted": "#6B6257",
    "--k-border": "#CFC6B6",
    "--k-primary": "#111111",
    "--k-on-primary": "#FFFDF7",
    "--k-accent": "#E63946",
    "--k-on-accent": "#FFFFFF",
    "--k-radius-xs": "0px",
    "--k-radius-sm": "0px",
    "--k-radius-md": "2px",
    "--k-radius-lg": "4px",
    "--k-bw": "2px",
    "--k-gap": "24px",
    "--k-pad": "28px",
    "--k-section-pad": "44px",
    "--k-fs": "16px",
    "--k-fs-h1": "48px",
    "--k-fs-h2": "34px",
    "--k-fs-h3": "22px",
    "--k-lh": "1.7",
    "--k-weight-strong": "700",
    "--k-track": "-.02em",
    "--k-shadow-sm": "none",
    "--k-shadow-md": "none",
    "--k-stage-bg": "linear-gradient(180deg, #EFE9DC, #F9F6EF)"
  }
}
