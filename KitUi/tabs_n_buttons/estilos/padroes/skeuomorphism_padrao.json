{
  "id": "skeuomorphism",
  "name": "Skeuorfismo",
  "family": "Padrão",
  "note": "Materiais físicos: relevo, brilho e texturas táteis.",
  "swatch": [
    "#B08D57",
    "#F1E7D2",
    "#4A3B2A"
  ],
  "font": "Source Serif 4",
  "radius": "round",
  "density": "regular",
  "tokens": {
    "--k-bg": "#E7DCC5",
    "--k-surface": "#F7F0E1",
    "--k-surface-2": "#D8C7A6",
    "--k-text": "#3B2F22",
    "--k-muted": "#7A6A55",
    "--k-border": "#B59E77",
    "--k-primary": "#8C6A3F",
    "--k-on-primary": "#FFF8EA",
    "--k-accent": "#B08D57",
    "--k-radius-sm": "8px",
    "--k-radius-md": "14px",
    "--k-radius-lg": "22px",
    "--k-bw": "2px",
    "--k-shadow-sm": "inset 0 1px 0 rgba(255,255,255,.85), 0 2px 3px rgba(60,40,20,.25)",
    "--k-shadow-md": "inset 0 2px 0 rgba(255,255,255,.7), 0 10px 24px rgba(60,40,20,.35)",
    "--k-shadow-inset": "inset 2px 2px 6px rgba(80,55,25,.35), inset -2px -2px 5px rgba(255,255,255,.6)",
    "--k-btn-shadow": "inset 0 2px 0 rgba(255,255,255,.75), 0 3px 5px rgba(60,40,20,.3)",
    "--k-btn-shadow-hover": "inset 0 2px 0 rgba(255,255,255,.8), 0 5px 10px rgba(60,40,20,.35)",
    "--k-field-inset": "inset 2px 3px 6px rgba(70,50,25,.28)",
    "--k-weight-strong": "700",
    "--k-stage-bg": "linear-gradient(135deg, #D9C8A6, #F2E9D6)"
  }
}
