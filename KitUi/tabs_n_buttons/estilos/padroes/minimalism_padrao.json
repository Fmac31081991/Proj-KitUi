{
  "id": "minimalism",
  "name": "Minimalismo",
  "family": "Padrão",
  "note": "Nada além do necessário: espaço, tipografia, silêncio.",
  "swatch": [
    "#0B0B0C",
    "#FFFFFF",
    "#EAEAEA"
  ],
  "font": "Inter",
  "radius": "soft",
  "density": "comfortable",
  "tokens": {
    "--k-bg": "#FFFFFF",
    "--k-surface": "#FFFFFF",
    "--k-surface-2": "#FAFAFA",
    "--k-text": "#0B0B0C",
    "--k-muted": "#6F6F76",
    "--k-border": "#E5E5E5",
    "--k-primary": "#0B0B0C",
    "--k-accent": "#6F6F76",
    "--k-danger": "#B42318",
    "--k-success": "#067647",
    "--k-focus": "#0B0B0C",
    "--k-radius-xs": "2px",
    "--k-radius-sm": "4px",
    "--k-radius-md": "6px",
    "--k-radius-lg": "8px",
    "--k-shadow-sm": "none",
    "--k-shadow-md": "none",
    "--k-shadow-inset": "none",
    "--k-pad": "32px",
    "--k-card-pad": "28px",
    "--k-section-pad": "40px",
    "--k-gap": "24px",
    "--k-pad-x": "18px",
    "--k-control-h": "46px",
    "--k-fs": "16px",
    "--k-lh": "1.6",
    "--k-weight-strong": "500",
    "--k-weight-label": "500",
    "--k-track": "-.01em",
    "--k-btn-hover-transform": "none",
    "--k-stage-bg": "#FAFAF9"
  }
}
