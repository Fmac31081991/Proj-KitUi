{
  "id": "bento",
  "name": "Bento UI",
  "family": "Padrão",
  "note": "Grades modulares, cards alinhados, respiro simétrico.",
  "swatch": [
    "#0F172A",
    "#F3F4F6",
    "#6366F1"
  ],
  "font": "DM Sans",
  "radius": "round",
  "density": "regular",
  "tokens": {
    "--k-bg": "#F2F3F6",
    "--k-surface": "#FFFFFF",
    "--k-surface-2": "#F7F8FA",
    "--k-text": "#0F172A",
    "--k-muted": "#64748B",
    "--k-border": "#E6E9EF",
    "--k-primary": "#0F172A",
    "--k-accent": "#6366F1",
    "--k-danger": "#E11D48",
    "--k-success": "#0E9F6E",
    "--k-focus": "#6366F1",
    "--k-radius-xs": "8px",
    "--k-radius-sm": "12px",
    "--k-radius-md": "16px",
    "--k-radius-lg": "22px",
    "--k-shadow-sm": "0 1px 2px rgba(15,23,42,.05)",
    "--k-shadow-md": "0 8px 24px rgba(15,23,42,.07)",
    "--k-btn-shadow": "0 1px 2px rgba(15,23,42,.16)",
    "--k-btn-shadow-hover": "0 4px 12px rgba(15,23,42,.16)",
    "--k-pad": "24px",
    "--k-card-pad": "22px",
    "--k-gap": "12px",
    "--k-pad-x": "18px",
    "--k-control-h": "40px",
    "--k-track": "-.01em",
    "--k-weight-strong": "600",
    "--k-weight-label": "500",
    "--k-stage-bg": "#F2F3F6",
    "--k-texture": "linear-gradient(rgba(15,23,42,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(15,23,42,.045) 1px, transparent 1px)",
    "--k-texture-size": "32px 32px"
  }
}
